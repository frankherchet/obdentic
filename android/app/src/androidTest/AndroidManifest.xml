<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <instrumentation android:name="de.obdentic.app.AcceptanceRunner" android:targetPackage="${testedApp}" android:label="Offline phone acceptance" />
    <instrumentation android:name="de.obdentic.app.RecordingAuditRunner" android:targetPackage="${testedApp}" android:label="Offline recording audit" />
    <instrumentation android:name="de.obdentic.app.AccountAcceptanceRunner" android:targetPackage="${testedApp}" android:label="ChatGPT account acceptance (simulated)" />
    <instrumentation android:name="de.obdentic.app.AgentAuditAcceptanceRunner" android:targetPackage="${testedApp}" android:label="Agent audit acceptance (simulated)" />
    <instrumentation android:name="de.obdentic.app.SharedDiagnosisRunner" android:targetPackage="${testedApp}" android:label="Shared diagnosis acceptance (simulated)" />
    <instrumentation
        android:name="de.obdentic.app.HardwareAcceptanceRunner"
        android:targetPackage="${testedApp}"
        android:label="OBDentic live vehicle acceptance"
        android:functionalTest="true" />
    <application>
        <provider android:name="de.obdentic.app.AuditTestProvider" android:authorities="de.obdentic.app.debug.test.audit"
            android:exported="true" android:grantUriPermissions="true" android:permission="android.permission.MANAGE_DOCUMENTS">
            <intent-filter><action android:name="android.content.action.DOCUMENTS_PROVIDER" /></intent-filter>
        </provider>
        <receiver android:name="de.obdentic.app.AuditGrantReceiver" android:exported="true" />
    </application>
</manifest>
